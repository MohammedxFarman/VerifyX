# Node >=22.12. Copy to .env; never commit your real values.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3000
# Set production on Render. npm start always enforces production.
NODE_ENV=development
# Production requires DATABASE_URL or DATA_DIR on a mounted persistent disk.
# Use your provider's TLS/CA configuration; never disable certificate validation.
DATABASE_URL=
# For local development only. On Render use a paid persistent disk path, not this value.
DATA_DIR=./data
# Canonical public origin, e.g. https://verifyx-fue5.onrender.com
APP_ORIGIN=
# Optional source retrieval and source comparison / safety assistant.
BRAVE_SEARCH_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional, operator-curated C2PA trust-anchor PEM file or inline PEM.
# Embedded checks run offline; no remote manifests / live OCSP retrieval.
C2PA_TRUST_ANCHORS=
# Browser tests use installed Chrome by default. Set to chromium for Playwright's bundled browser.
PLAYWRIGHT_CHANNEL=chrome
